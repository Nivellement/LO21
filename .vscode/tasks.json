{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build projet",
            "type": "shell",
            "command": "g++",
            "args": [
                "-g",
                "-std=c++17",
                "-Wall",
                "main.cpp",
                "manager.cpp",
                "pioche.cpp",
                "player.cpp",
                "tybor.cpp",
                "carte/*.cpp",
                "-o",
                "bin/Debug/Codex_Naturalis"
            ],
            "options": { "cwd": "${workspaceFolder}" },
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": ["$gcc"]
        }
    ]
}